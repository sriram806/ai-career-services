# ============================================
# AI Career OS — Environment Variables Example
# ============================================
# Copy this file to .env and fill in the values.
# NEVER commit .env files with real secrets.
# ============================================

# ---- Application ----
NODE_ENV=development
LOG_LEVEL=debug
PORT=4000
API_VERSION=v1

# ---- PostgreSQL ----
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=ai_career_os
POSTGRES_PASSWORD=changeme_postgres
POSTGRES_DB=ai_career_os

# ---- MongoDB ----
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_USER=ai_career_os
MONGO_PASSWORD=changeme_mongo
MONGO_DB=ai_career_os
MONGO_URI=mongodb://127.0.0.1:27017/ai_career_os

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=changeme_redis

# ---- JWT ----
JWT_SECRET=changeme_jwt_secret_minimum_32_chars_long
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ---- CORS ----
CORS_ORIGIN=http://localhost:3000,https://ai-os-nova.vercel.app
AUTH_OAUTH_REDIRECT_URI=http://localhost:4000/api/v1/auth/oauth/callback

# ---- Rate Limiting ----
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ---- S3 Compatible Storage ----
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=changeme_s3_access
S3_SECRET_KEY=changeme_s3_secret
S3_BUCKET=ai-career-os
S3_REGION=us-east-1

# ---- AI Service ----
AI_SERVICE_URL=http://localhost:3005
OPENAI_API_KEY=changeme_openai_key

# ---- Kafka (Future) ----
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=ai-career-os
KAFKA_GROUP_ID=ai-career-os-group

# ---- Service Ports ----
GATEWAY_PORT=4000
AUTH_SERVICE_PORT=3001
USER_SERVICE_PORT=3002
CAREER_SERVICE_PORT=3003
EXAM_SERVICE_PORT=3004
AI_SERVICE_PORT=3005
ORG_SERVICE_PORT=3006
BILLING_SERVICE_PORT=3007
NOTIFICATION_SERVICE_PORT=3008
ADMIN_SERVICE_PORT=3009
ANALYTICS_SERVICE_PORT=3010
GITHUB_IMPORT_SERVICE_PORT=3012

# ---- Downstream Microservice URLs (Gateway) ----
AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
CAREER_SERVICE_URL=http://localhost:3003
EXAM_SERVICE_URL=http://localhost:3004
ORGANIZATION_SERVICE_URL=http://localhost:3006
BILLING_SERVICE_URL=http://localhost:3007
NOTIFICATION_SERVICE_URL=http://localhost:3008
ADMIN_SERVICE_URL=http://localhost:3009
ANALYTICS_SERVICE_URL=http://localhost:3010
GITHUB_IMPORT_SERVICE_URL=http://localhost:3012

# ---- SMTP Mailer ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=boddusriram1234@gmail.com
SMTP_PASS=changeme_smtp_app_password
SMTP_SECURE=true
SMTP_FROM="AI Career OS <noreply@aicareeros.com>"

# ---- GitHub OAuth ----
GITHUB_CLIENT_ID=mock_github_client_id
GITHUB_CLIENT_SECRET=mock_github_client_secret
GITHUB_OAUTH_ENCRYPTION_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=mock_google_client_id
GOOGLE_CLIENT_SECRET=mock_google_client_secret

# ---- Microsoft OAuth ----
MICROSOFT_CLIENT_ID=mock_microsoft_client_id
MICROSOFT_CLIENT_SECRET=mock_microsoft_client_secret

# ---- LinkedIn OAuth ----
LINKEDIN_CLIENT_ID=mock_linkedin_client_id
LINKEDIN_CLIENT_SECRET=mock_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:4000/api/v1/profile/linkedin/oauth/callback
LINKEDIN_FRONTEND_REDIRECT=http://localhost:3000/profile/linkedin
